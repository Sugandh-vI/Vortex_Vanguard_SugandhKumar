# Copy this file to .env and fill in your values
# Never commit .env to version control

# Ollama configuration — leave defaults to use local ollama serve
# The LLM client is provider-agnostic; any OpenAI-compatible base URL works.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=minimax-m3:cloud

# Max tokens per narration call. Reasoning/cloud models (e.g.
# minimax-m3:cloud) can spend a large share of this budget on "thinking"
# before emitting visible text; 1024 was observed to truncate ALL
# outputs and to produce empty content when the budget went to
# reasoning, so keep this >= 4096.
OLLAMA_MAX_TOKENS=4096

# Set to "true" to send `think: false` to Ollama so reasoning models
# narrate directly instead of burning the token budget on thinking
# (helps if narratives come back empty/truncated even at 4096).
OLLAMA_DISABLE_THINKING=false

# Set to "true" to force mock-LLM mode (no real LLM calls)
# If Ollama is unavailable, mock mode activates automatically.
LLM_MOCK_MODE=false

# Telemetry cost rates (USD per 1M tokens) for the estimated
# cost-at-scale figure (GET /telemetry). Ollama's free-tier cloud
# model costs $0, so leave both at 0.0. Set hypothetical paid rates
# (e.g. 2.0 / 3.0) to see what the same recorded token volume would
# cost at scale on a paid API.
TELEMETRY_INPUT_RATE_1M=0.0
TELEMETRY_OUTPUT_RATE_1M=0.0
